@model Application.Auth.Dto.SendOtpEmailModel;

@{
	Layout = null;
	// Hex Colors
	var brandBlue = "#2563EB";
	var textGray = "#4B5563";
	var bgLight = "#F3F4F6";
	var white = "#FFFFFF";
}

<!DOCTYPE html>
<html>
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<title>Verify Your Account</title>
	<style>
		/* Basic responsive fix for mobile clients */
		@@media only screen and (max-width: 620px) {
			.container {
				width: 100% !important;
				padding: 20px !important;
			}
		}
	</style>
</head>
<body style="background-color: @bgLight; font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 0;">
	<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td align="center" style="padding: 40px 0;">
				<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="600" class="container" style="background-color: @white; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 6px rgba(0,0,0,0.1);">

					<tr>
						<td align="center" style="padding: 30px; background-color: @brandBlue;">
							<h1 style="color: @white; margin: 0; font-size: 24px; letter-spacing: 1px;">PHED</h1>
						</td>
					</tr>

					<tr>
						<td style="padding: 40px 30px;">
							<h2 style="color: #111827; margin-top: 0;">Verification Required</h2>
							<p style="color: @textGray; font-size: 16px; line-height: 1.5;">
								Hello @Model.UserName,
							</p>
							<p style="color: @textGray; font-size: 16px; line-height: 1.5;">
								You recently requested to access your Uber Eats account history. Please use the verification code below to complete your sign-in:
							</p>

							<div style="text-align: center; margin: 30px 0; padding: 20px; background-color: #F9FAFB; border: 1px dashed #D1D5DB; border-radius: 4px;">
								<span style="font-size: 32px; font-weight: bold; letter-spacing: 8px; color: @brandBlue;">@Model.OtpCode</span>
							</div>

							<p style="color: @textGray; font-size: 14px; line-height: 1.5;">
								<strong>Note:</strong> This code is valid for the next 15 minutes. If you did not request this code, please ignore this email or contact support.
							</p>
						</td>
					</tr>

					<tr>
						<td style="padding: 20px 30px; background-color: #F9FAFB; border-top: 1px solid #E5E7EB; text-align: center;">
							<p style="color: #9CA3AF; font-size: 12px; margin: 0;">
								&copy; @DateTime.Now.Year Uber Eats. <br />
							</p>
						</td>
					</tr>
				</table>
			</td>
		</tr>
	</table>
</body>
</html>