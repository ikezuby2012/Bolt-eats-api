@model Application.Auth.Dto.SendOtpEmailModel;

@{
	Layout = null;
	// Chill Eats Brand Colors
	var brandPrimary = "#FF6B35";    // Zesty Orange
	var brandSecondary = "#F7C35C";   // Warm Yellow
	var textDark = "#2D2F36";
	var textGray = "#6B7280";
	var bgLight = "#FFF8F0";          // Soft cream background
	var white = "#FFFFFF";
	var accentMint = "#10B981";       // Fresh accent for success/validity
}

<!DOCTYPE html>
<html>
<head>
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
	<title>🍕 Verify your Chill Eats account</title>
	<style>
		/* Responsive */
		@@media only screen and (max-width: 620px) {
			.container {
				width: 100% !important;
				padding: 20px !important;
			}

			.code-block {
				font-size: 28px !important;
				letter-spacing: 6px !important;
				padding: 16px !important;
			}
		}
		/* Subtle hover effect for button/links (desktop) */
		.hover-link:hover {
			color: @brandPrimary !important;
		}
	</style>
</head>
<body style="background-color: @bgLight; font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif; margin: 0; padding: 0;">
	<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="100%">
		<tr>
			<td align="center" style="padding: 48px 0 24px 0;">
				<!-- Main container card -->
				<table role="presentation" border="0" cellpadding="0" cellspacing="0" width="560" class="container" style="background-color: @white; border-radius: 28px; overflow: hidden; box-shadow: 0 20px 35px -12px rgba(0,0,0,0.1); max-width: 560px; width: 100%;">

					<!-- Header with decorative wave & food illustration feel -->
					<tr>
						<td style="background: linear-gradient(135deg, @brandPrimary 0%, #FF8C42 100%); padding: 32px 30px 24px; text-align: center;">
							<div style="margin-bottom: 12px;">
								🍔🍕🌮
							</div>
							<h1 style="color: @white; margin: 0; font-size: 32px; font-weight: 800; letter-spacing: -0.5px;">chill eats</h1>
							<p style="color: rgba(255,255,240,0.9); margin: 8px 0 0 0; font-size: 14px;">your flavor adventure starts here</p>
						</td>
					</tr>

					<tr>
						<td style="padding: 38px 32px 28px;">
							<!-- Greeting with friendly emoji -->
							<h2 style="color: @textDark; margin-top: 0; margin-bottom: 8px; font-size: 22px; font-weight: 700;">Hey there, @Model.UserName! 👋</h2>

							<p style="color: @textGray; font-size: 16px; line-height: 1.5; margin-bottom: 24px;">
								You’re just <strong style="color: @brandPrimary;">one step away</strong> from diving into deliciousness. Use the secure code below to verify your account or complete your sign-in on <strong>Chill Eats</strong>.
							</p>

							<!-- Verification code card with fresh design -->
							<div style="text-align: center; margin: 28px 0 24px; background: #FFF2E9; border-radius: 24px; padding: 24px 16px; border: 1px solid rgba(255,107,53,0.2);">
								<span style="font-size: 34px; font-weight: 800; letter-spacing: 10px; color: @brandPrimary; background: @white; padding: 12px 20px; border-radius: 60px; display: inline-block; box-shadow: 0 2px 8px rgba(0,0,0,0.03);">@Model.OtpCode</span>
								<p style="margin: 20px 0 0 0; font-size: 13px; color: @accentMint; font-weight: 500;">
									⏱️ Valid for 15 minutes — fresh like hot fries!
								</p>
							</div>

							<!-- Explanation tip with chill vibe -->
							<table width="100%" style="margin-bottom: 18px;">
								<tr>
									<td style="padding: 12px 0 0 0;">
										<div style="background-color: #FEF9F0; border-radius: 20px; padding: 14px 20px;">
											<p style="margin: 0 0 6px 0; font-size: 14px; font-weight: 600; color: @textDark;">🍽️ Why are we sending this?</p>
											<p style="margin: 0; font-size: 14px; line-height: 1.45; color: @textGray;">To keep your cravings — and your account — safe. This code verifies it's really you (and not a veggie-stealing goblin).</p>
										</div>
									</td>
								</tr>
							</table>

							<p style="color: @textGray; font-size: 13px; line-height: 1.5; margin-top: 20px; border-left: 3px solid @brandSecondary; padding-left: 14px;">
								<strong>🔒 Didn’t request this?</strong> No worries — just ignore this email. Your Chill Eats account stays secure. If you have any concerns, reach out to our support team anytime.
							</p>
						</td>
					</tr>

					<!-- Footer with brand touches -->
					<tr>
						<td style="padding: 20px 32px 28px; background-color: #FEFAF5; border-top: 1px solid #FFE5D5; text-align: center;">
							<div style="margin-bottom: 12px;">
								<span style="color: @brandPrimary; font-weight: 600; font-size: 13px;">chill eats</span>
								<span style="color: #DDD0C2; margin: 0 6px;">✦</span>
								<span style="color: @textGray; font-size: 12px;">delivered with love</span>
							</div>
							<p style="color: #9CA3AF; font-size: 12px; margin: 0 0 8px 0;">
								© @DateTime.Now.Year Chill Eats — satisfy your hunger, anytime.
							</p>
							<p style="color: #BCA88F; font-size: 11px; margin: 0;">
								🍟 Craving help? <a href="#" style="color: @brandPrimary; text-decoration: none; font-weight: 500;" class="hover-link">Contact our kitchen crew</a>
							</p>
						</td>
					</tr>
				</table>
				<!-- tiny spacer note for privacy -->
				<p style="text-align: center; font-size: 11px; color: #AAAFB5; margin-top: 28px;">Chill Eats • secure verification • don't share this code</p>
			</td>
		</tr>
	</table>
</body>
</html>